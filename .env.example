# Spotify app credentials — https://developer.spotify.com/dashboard
# Enable both "Web API" and "Web Playback SDK" in your app settings.
# Add http://127.0.0.1:3000/callback to Redirect URIs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# Market used for search results (ISO country code)
SPOTIFY_MARKET=US

# How many unique dislikes skip the current song
DISLIKES_TO_SKIP=5

# Minutes before the same song can play again
REPLAY_COOLDOWN_MINUTES=30

# Max songs one person can enqueue per window
ENQUEUE_MAX_PER_WINDOW=3
ENQUEUE_WINDOW_MINUTES=10

# Max vote actions (like/dislike changes) per person per song
MAX_VOTES_PER_TRACK=2

# Port
PORT=3000
