# ============================================================
# dev3pack-hub-music — Environment Configuration
# Copy to .env and fill in your Spotify credentials.
# ============================================================

# --- Spotify API (https://developer.spotify.com/dashboard) ---
# Enable both "Web API" and "Web Playback SDK" in your app settings.
# Add SPOTIFY_REDIRECT_URI to your app's Redirect URIs allowlist.
# Leave blank to run in offline demo mode with a built-in catalog.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback
SPOTIFY_MARKET=US

# --- Host Authentication & Proxy ---
# Required when deploying publicly to protect Spotify host OAuth.
# Exchange via POST /api/spotify/authorize (X-Admin-Key header or JSON { "key": "..." })
# before navigating to /api/spotify/login. On 127.0.0.1 it works without a key.
HOST_ADMIN_SECRET=

# Set to 1 ONLY when running behind a trusted reverse proxy
# (Railway, Render, Fly.io, Cloudflare Tunnel, Caddy, Nginx).
TRUST_PROXY=0

# --- Room Rules & Limits ---
# Net dislikes (dislikes - likes) required to skip the current song
DISLIKES_TO_SKIP=5

# Minimum minutes before the same song can be queued/played again
REPLAY_COOLDOWN_MINUTES=30

# Per-person enqueue rate limit
ENQUEUE_MAX_PER_WINDOW=3
ENQUEUE_WINDOW_MINUTES=10

# Reject tracks longer than this duration (minutes)
MAX_TRACK_MINUTES=7

# Maximum vote actions (like/dislike changes) per person per song
MAX_VOTES_PER_TRACK=2

# Room capacity & per-IP limits (tuned for shared hackathon Wi-Fi NAT)
MAX_CLIENTS=250
JOIN_RATE_MAX_PER_IP=200
SEARCH_RATE_MAX_PER_IP=180
MUTATE_RATE_MAX_PER_IP=300

# Grace period (ms) before dropping a disconnected WebSocket session (preserves F5 reloads)
DISCONNECT_GRACE_MS=8000

# --- Database (SQLite via Node built-in node:sqlite) ---
# Stores user aliases/emojis (with pseudonymized IP hashes) and full track history
DB_PATH=./data/music-hub.sqlite

# --- Server ---
PORT=3000
